{
  "name": "aaa-asset-administration-assistant",
  "productName": "AAA",
  "version": "0.2.2",
  "description": "Asset Administration Assistant",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "generate:twemoji": "node scripts/generate-twemoji-manifest.cjs",
    "dev": "npm run generate:twemoji && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run generate:twemoji && vite build",
    "build:ai": "python -m PyInstaller --noconfirm --clean --distpath python-dist --workpath python-build ai-runtime/aaa-ai-worker.spec",
    "package:ai": "node scripts/package-ai-runtime.cjs",
    "verify:licenses": "node scripts/verify-license-files.cjs",
    "dist:ai": "npm run verify:licenses && npm run build:ai && npm run package:ai",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm run verify:licenses && npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@twemoji/api": "17.0.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.29.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.jzzzang.aaa",
    "productName": "AAA",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "AAA-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/AAA-AGPL-3.0.txt"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/AAA_icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AAA",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JZ-ZZANG",
        "repo": "AAA",
        "releaseType": "draft"
      }
    ]
  }
}
